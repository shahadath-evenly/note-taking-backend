NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/secure_notes
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=100kb

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=1h

# Auth rate limiting (applies to /api/auth/register and /api/auth/login)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Admin bootstrap (used only by `npm run seed:admin`, never by the server)
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
